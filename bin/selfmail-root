#!/usr/bin/env bash
# selfmail-root — the ONLY commands the web app may run as root (via sudo).
# Every argument is validated here; nothing is passed to a shell.
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
umask 077

die() { echo "selfmail-root: $*" >&2; exit 2; }
host_ok() { [[ "$1" =~ ^([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]{2,63}$ ]]; }

op="${1:-}"; shift || true
case "$op" in
  log)
    n="${1:-300}"; [[ "$n" =~ ^[0-9]{1,4}$ ]] || die "bad line count"
    for f in /var/log/mail.log /var/log/maillog; do
      if [ -s "$f" ]; then exec tail -n "$n" "$f"; fi
    done
    exec journalctl --no-pager -o short -n "$n" SYSLOG_FACILITY=2
    ;;
  queue-flush)
    exec postqueue -f
    ;;
  queue-delete)
    id="${1:-}"; [[ "$id" =~ ^([A-F0-9]{6,20}|ALL)$ ]] || die "bad queue id"
    exec postsuper -d "$id"
    ;;
  relay-set)
    # relay-set HOST PORT USER [primary|backup]   (password on stdin; empty = keep the stored one)
    #   primary: every message goes through the relay (relayhost)
    #   backup:  direct delivery first; Postfix hands a message to the relay only
    #            when the recipient's server can't be reached (smtp_fallback_relay)
    host="${1:-}"; port="${2:-}"; user="${3:-}"; role="${4:-primary}"
    host_ok "$host" || die "bad host"
    [[ "$port" =~ ^(25|465|587|2525)$ ]] || die "bad port"
    [[ "$user" =~ ^[^[:space:]:]{1,200}$ ]] || die "bad user"
    [[ "$role" =~ ^(primary|backup)$ ]] || die "bad role"
    [ "$role" = backup ] && [ "$port" = 465 ] && die "port 465 can't be a per-message backup; use 587 or 2525"
    IFS= read -r pass || true
    if [ -z "$pass" ]; then
      # keep the stored password when only the port/role/user changed
      pass="$(awk -v k="[$host]:" 'index($0, k)==1 {r=substr($0, index($0, " ")+1); print substr(r, index(r, ":")+1)}' /etc/postfix/sasl_passwd 2>/dev/null | head -1)"
      [ -n "$pass" ] || die "no password given"
    fi
    [[ "$pass" != *$'\n'* ]] || die "bad password"
    printf '[%s]:%s %s:%s\n' "$host" "$port" "$user" "$pass" > /etc/postfix/sasl_passwd
    chmod 600 /etc/postfix/sasl_passwd; postmap /etc/postfix/sasl_passwd; chmod 600 /etc/postfix/sasl_passwd.db 2>/dev/null || true
    printf '[%s]:%s encrypt\n' "$host" "$port" > /etc/postfix/tls_policy; postmap /etc/postfix/tls_policy
    common=("smtp_sasl_auth_enable = yes" "smtp_sasl_password_maps = hash:/etc/postfix/sasl_passwd" "smtp_sasl_security_options = noanonymous" "smtp_sasl_tls_security_options = noanonymous")
    if [ "$role" = primary ]; then
      wrapper=no; [ "$port" = 465 ] && wrapper=yes
      postconf -e "${common[@]}" "relayhost = [$host]:$port" "smtp_fallback_relay =" "smtp_tls_security_level = encrypt" "smtp_tls_wrappermode = $wrapper" "smtp_tls_policy_maps ="
    else
      postconf -e "${common[@]}" "relayhost =" "smtp_fallback_relay = [$host]:$port" "smtp_tls_security_level = may" "smtp_tls_wrappermode = no" "smtp_tls_policy_maps = hash:/etc/postfix/tls_policy"
    fi
    postfix reload >/dev/null 2>&1 || systemctl restart postfix
    echo "relay [$host]:$port ($role)"
    ;;
  relay-clear)
    postconf -e "relayhost =" "smtp_fallback_relay =" "smtp_sasl_auth_enable = no" "smtp_tls_security_level = may" "smtp_tls_wrappermode = no" "smtp_tls_policy_maps ="
    rm -f /etc/postfix/sasl_passwd /etc/postfix/sasl_passwd.db /etc/postfix/tls_policy /etc/postfix/tls_policy.db
    postfix reload >/dev/null 2>&1 || systemctl restart postfix
    echo "sending directly"
    ;;
  hostname-set)
    name="${1:-}"; host_ok "$name" || die "bad host name"
    postconf -e "myhostname = $name"
    postfix reload >/dev/null 2>&1 || true
    echo "myhostname = $name"
    ;;
  restart)
    unit="${1:-}"
    [[ "$unit" =~ ^(postfix|opendkim|selfmail-tunnel|cloudflared[A-Za-z0-9@._-]*)$ ]] || die "not allowed: $unit"
    systemctl restart "$unit"
    echo "restarted $unit"
    ;;
  domain-add)
    # domain-add DOMAIN SELECTOR MAILBOX@MAIN — take mail for DOMAIN too (catch-all into the main
    # mailbox) and sign mail from it with its own DKIM key. Safe to run again.
    d="${1:-}"; s="${2:-}"; target="${3:-}"
    host_ok "$d" || die "bad domain"; [[ "$s" =~ ^[A-Za-z0-9._-]{1,63}$ ]] || die "bad selector"
    [[ "$target" =~ ^[A-Za-z0-9._+-]{1,64}@([A-Za-z0-9-]+\.)+[A-Za-z]{2,63}$ ]] || die "bad mailbox"
    d="${d,,}"
    mkdir -p "/etc/opendkim/keys/$d"
    if [ ! -f "/etc/opendkim/keys/$d/$s.private" ]; then ( cd "/etc/opendkim/keys/$d" && opendkim-genkey -b 2048 -d "$d" -s "$s" ); fi
    chown -R opendkim:opendkim "/etc/opendkim/keys/$d"; chmod 700 "/etc/opendkim/keys/$d"; chmod 600 "/etc/opendkim/keys/$d/$s.private"
    kt="$s._domainkey.$d $d:$s:/etc/opendkim/keys/$d/$s.private"; st="*@$d $s._domainkey.$d"
    grep -qxF "$kt" /etc/opendkim/key.table 2>/dev/null || echo "$kt" >> /etc/opendkim/key.table
    grep -qxF "$st" /etc/opendkim/signing.table 2>/dev/null || echo "$st" >> /etc/opendkim/signing.table
    doms="$(postconf -h virtual_mailbox_domains | tr ', ' '\n\n' | sed '/^$/d')"
    printf '%s\n' "$doms" | grep -qxF "$d" || postconf -e "virtual_mailbox_domains = $(printf '%s\n%s\n' "$doms" "$d" | sed '/^$/d' | paste -sd, - | sed 's/,/, /g')"
    va="$(printf '@%s\t%s' "$d" "$target")"
    grep -qxF "$va" /etc/postfix/virtual 2>/dev/null || { awk -v k="@$d" '$1 != k' /etc/postfix/virtual > /etc/postfix/virtual.new 2>/dev/null || true; echo "$va" >> /etc/postfix/virtual.new; mv /etc/postfix/virtual.new /etc/postfix/virtual; }
    postmap /etc/postfix/virtual
    systemctl restart opendkim; postfix reload >/dev/null 2>&1 || systemctl restart postfix
    echo "taking mail for @$d"
    ;;
  domain-remove)
    d="${1:-}"; host_ok "$d" || die "bad domain"; d="${d,,}"
    main="$(postconf -h virtual_mailbox_domains | tr ', ' '\n\n' | sed '/^$/d' | head -1)"
    [ "$d" = "$main" ] && die "that's the main domain"
    awk -v d="$d" 'index($2, d":") != 1' /etc/opendkim/key.table > /etc/opendkim/key.table.new || true; mv /etc/opendkim/key.table.new /etc/opendkim/key.table
    awk -v k="*@$d" '$1 != k' /etc/opendkim/signing.table > /etc/opendkim/signing.table.new || true; mv /etc/opendkim/signing.table.new /etc/opendkim/signing.table
    chown opendkim:opendkim /etc/opendkim/key.table /etc/opendkim/signing.table
    postconf -e "virtual_mailbox_domains = $(postconf -h virtual_mailbox_domains | tr ', ' '\n\n' | sed '/^$/d' | grep -vxF "$d" | paste -sd, - | sed 's/,/, /g')"
    awk -v k="@$d" '$1 != k' /etc/postfix/virtual > /etc/postfix/virtual.new || true; mv /etc/postfix/virtual.new /etc/postfix/virtual; postmap /etc/postfix/virtual
    systemctl restart opendkim; postfix reload >/dev/null 2>&1 || systemctl restart postfix
    echo "no longer taking mail for @$d (its DKIM key is kept in /etc/opendkim/keys/$d)"
    ;;
  dkim-public)
    d="${1:-}"; s="${2:-}"
    host_ok "$d" || die "bad domain"; [[ "$s" =~ ^[A-Za-z0-9._-]{1,63}$ ]] || die "bad selector"
    exec cat "/etc/opendkim/keys/$d/$s.txt"
    ;;
  *)
    die "unknown operation: ${op:-<none>}"
    ;;
esac
